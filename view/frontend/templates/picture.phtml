<?php declare(strict_types=1);

use Magento\Framework\Escaper;
use Yireo\NextGenImages\Block\Picture;

/** @version 0.5.18 */
/** @var Picture $block */
/** @var Escaper $escaper */

$width = ($block->getWidth()) ? ' width="'.$escaper->escapeHtmlAttr($block->getWidth()).'"' : '';
$height = ($block->getHeight()) ? ' height="'.$escaper->escapeHtmlAttr($block->getHeight()).'"' : '';
$class = ($block->getClass()) ? ' class="'.$escaper->escapeHtmlAttr($block->getClass()).'"' : '';
$originalTag = trim($block->getOriginalTag(), " \f\n\r\t\v\x00");
$hasLoadingAttribute = (bool)preg_match('/\sloading\s*=/i', $originalTag);
$lazyLoading = ($block->getLazyLoading() && !$hasLoadingAttribute) ? ' loading="lazy" ' : '';
$originalTag = preg_replace('/(\/?)>$/', $lazyLoading.'\1>', $originalTag);
$originalImage = $block->getOriginalImage();
$originalImageType = $block->getOriginalImageType();
$srcAttribute = $block->getSrcAttribute() ?? 'src';
$srcSetAttribute = $srcAttribute.'set'; 
?>
<picture<?= /* @noEscape */ $class ?>>
    <?php if ($block->getDebug()): ?>
        <!-- <?= $escaper->escapeHtml($block->getOriginalAttributesAsString()) ?> -->
    <?php endif; ?>
  
    <?php foreach ($block->getImages() as $image): ?>
        <source 
            type="<?= $escaper->escapeHtml($image->getMimeType()) ?>" 
            <?= /* @noEscape */ $srcSetAttribute ?>="<?= $escaper->escapeHtml($image->getSrcSet() ?: $image->getUrl()) ?>" 
            <?= /* @noEscape */ $block->getSourceAttributesAsString() ?>
        >
    <?php endforeach; ?>
    <?= /* @noEscape */ $originalTag ?>
</picture>
